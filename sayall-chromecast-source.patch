+
+    @Test func voiceOnboardingKeepsTheConnectionAndTranscriptionRequirements() {
+        let sources = OnboardingBuildCapabilities.availableControlSources(siriRemotePackageInstalled: false)
+        #expect(OnboardingControlSourceVisibilityPolicy.visibleSources(sources).contains(.chromecastRemote))
+        #expect(OnboardingControlSource.chromecastRemote.supportedGestureModes == [.hold])
+        for tool in [OnboardingVoiceTool.doubao, .weixin] {
+            let plan = OnboardingVoicePairingPlan.resolve(
+                tool: tool, controlSource: .chromecastRemote, preferredGesture: .toggle, forceFunctionKey: true
+            )
+            #expect(plan?.binding.gestureMode == .hold)
+            #expect(plan?.binding.shortcut == .function)
+            #expect(plan?.chromecastVoiceMode == .hold)
+        }
+
+        var capabilities = OnboardingCapabilities()
+        #expect(!OnboardingFlowPolicy.canContinue(
+            from: .remote, voiceTool: .doubao, controlSource: .chromecastRemote, capabilities: capabilities
+        ))
+        capabilities.remoteConnected = true
+        #expect(OnboardingFlowPolicy.canContinue(
+            from: .remote, voiceTool: .doubao, controlSource: .chromecastRemote, capabilities: capabilities
+        ))
+        #expect(!OnboardingFlowPolicy.canContinue(
+            from: .remote, voiceTool: .doubao, controlSource: .xiaomiRemote, capabilities: capabilities
+        ))
+        #expect(!OnboardingFlowPolicy.canContinue(
+            from: .voiceTest, voiceTool: .doubao, controlSource: .chromecastRemote, capabilities: capabilities
+        ))
+    }
+}
