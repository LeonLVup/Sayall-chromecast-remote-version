@@ -0,0 +1,79 @@
+#if SAYALL_PUBLIC_CHROMECAST_VOICE
+import SwiftUI
+
+/// A schematic of the Chromecast with Google TV Voice Remote (G9N9N).
+struct ChromecastVoiceRemoteDrawing: View {
+    let voiceActive: Bool
+
+    private let drawingSize = CGSize(width: 112, height: 290)
+    private let buttonColor = Color(red: 0.94, green: 0.95, blue: 0.96)
+    private let ink = Color(red: 0.22, green: 0.25, blue: 0.30)
+    private let outline = Color(red: 0.77, green: 0.80, blue: 0.84)
+
+    var body: some View {
+        GeometryReader { proxy in
+            let scale = min(proxy.size.width / drawingSize.width, proxy.size.height / drawingSize.height)
+            remote
+                .frame(width: drawingSize.width, height: drawingSize.height)
+                .scaleEffect(scale)
+                .position(x: proxy.size.width / 2, y: proxy.size.height / 2)
+        }
+        .accessibilityLabel(Text("chromecast.local.title"))
+    }
+
+    private var remote: some View {
+        ZStack {
+            RoundedRectangle(cornerRadius: 43)
+                .fill(Color(red: 0.99, green: 0.99, blue: 1))
+                .strokeBorder(outline, lineWidth: 1)
+                .frame(width: 100, height: 280)
+                .position(x: 54, y: 145)
+            VStack(spacing: 12) {
+                Image(systemName: "plus")
+                Image(systemName: "minus")
+            }
+            .font(.system(size: 6, weight: .semibold))
+            .foregroundStyle(ink)
+            .frame(width: 11, height: 56)
+            .background(outline, in: Capsule())
+            .position(x: 105, y: 117)
+            Circle()
+                .fill(buttonColor)
+                .strokeBorder(outline, lineWidth: 1)
+                .frame(width: 74, height: 74)
+                .position(x: 54, y: 55)
+            Circle()
+                .fill(.white)
+                .strokeBorder(outline, lineWidth: 1)
+                .frame(width: 36, height: 36)
+                .position(x: 54, y: 55)
+
+            button(x: 33, y: 114) { Image(systemName: "chevron.left") }
+            button(x: 75, y: 114, highlighted: true) { Image(systemName: "mic.fill") }
+            button(x: 33, y: 154) { Image(systemName: "house") }
+            button(x: 75, y: 154) { Image(systemName: "speaker.slash") }
+            button(x: 33, y: 194) { Text("YouTube").font(.system(size: 7, weight: .semibold)) }
+            button(x: 75, y: 194) { Text("Netflix").font(.system(size: 8, weight: .semibold)) }
+            button(x: 33, y: 234, size: 22) { Image(systemName: "power") }
+            button(x: 75, y: 234, size: 22) { Image(systemName: "rectangle.portrait.and.arrow.right") }
+        }
+    }
+
+    private func button<Glyph: View>(
+        x: CGFloat,
+        y: CGFloat,
+        size: CGFloat = 32,
+        highlighted: Bool = false,
+        @ViewBuilder glyph: () -> Glyph
+    ) -> some View {
+        let accent = voiceActive ? Color.orange : Color.accentColor
+        return glyph()
+            .font(.system(size: size * 0.38, weight: .medium))
+            .foregroundStyle(highlighted ? accent : ink)
+            .frame(width: size, height: size)
+            .background(highlighted ? accent.opacity(0.16) : buttonColor, in: Circle())
+            .overlay(Circle().strokeBorder(highlighted ? accent : outline, lineWidth: highlighted ? 1.5 : 0.75))
+            .position(x: x, y: y)
+    }
+}
+#endif
