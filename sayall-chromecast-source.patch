+
+@testable import RemoteMic
+
+struct ChromecastPublicVoiceTests {
+    @Test func fixedInputSwitchIgnoresOtherInputSources() {
+        let doubao = OnboardingVoiceTool.doubao.preferredInputSourceID
+        let weixin = OnboardingVoiceTool.weixin.preferredInputSourceID
+        let abc = "com.apple.keylayout.ABC"
+        #expect(OnboardingVoiceTool.nextChineseVoiceInputMethod(activeSourceID: doubao, lastUsed: .weixin) == .weixin)
+        #expect(OnboardingVoiceTool.nextChineseVoiceInputMethod(activeSourceID: weixin, lastUsed: .doubao) == .doubao)
+        #expect(OnboardingVoiceTool.nextChineseVoiceInputMethod(activeSourceID: abc, lastUsed: .doubao) == .weixin)
+        #expect(OnboardingVoiceTool.nextChineseVoiceInputMethod(activeSourceID: abc, lastUsed: .weixin) == .doubao)
+        #expect(OnboardingVoiceTool.nextChineseVoiceInputMethod(activeSourceID: abc, lastUsed: nil) == .doubao)
+    }
+
+    @Test func mapsTheSupportedG9N9NConsumerControls() {
+        #expect(ChromecastHIDControlMap.controls[0x041] == .select)
+        #expect(ChromecastHIDControlMap.controls[0x042] == .up)
+        #expect(ChromecastHIDControlMap.controls[0x043] == .down)
+        #expect(ChromecastHIDControlMap.controls[0x044] == .left)
+        #expect(ChromecastHIDControlMap.controls[0x045] == .right)
+        #expect(ChromecastHIDControlMap.controls[0x223] == .home)
+        #expect(ChromecastHIDControlMap.controls[0x224] == .back)
+        #expect(ChromecastHIDControlMap.controls[0x077] == .youtube)
+        #expect(ChromecastHIDControlMap.controls[0x078] == .netflix)
+        #expect(ChromecastHIDControlMap.controls[0x0e2] == .mute)
+        #expect(ChromecastHIDControlMap.controls[0x0e9] == .volumeUp)
+        #expect(ChromecastHIDControlMap.controls[0x0ea] == .volumeDown)
+        #expect(ChromecastHIDControlMap.nativeSources.count == 12)
+        #expect(ChromecastHIDControlMap.nativeSources.allSatisfy { $0 >> 32 == 0x0c })
+        #expect(Set(ChromecastHIDControlMap.controls.values.map(\.remoteButton)) ==
+            Set(ChromecastHIDControlMap.displayOrder))
+    }
+
+    @Test func requiresTheChromecastPnPIdentity() {
+        #expect(ChromecastVoiceBridge.matchesPnPID(Data([1, 0xD1, 0x18, 0x50, 0x94, 0x10, 1])))
+        #expect(ChromecastVoiceBridge.matchesPnPID(Data([2, 0xD1, 0x18, 0x50, 0x94, 0x10, 1])))
+        #expect(!ChromecastVoiceBridge.matchesPnPID(Data([0, 0xD1, 0x18, 0x50, 0x94, 0x10, 1])))
+        #expect(!ChromecastVoiceBridge.matchesPnPID(Data([2, 0x17, 0x27, 0xB8, 0x32, 0, 0])))
+        #expect(!ChromecastVoiceBridge.matchesPnPID(Data([2, 0xD1, 0x18, 0x50, 0x94])))
+    }
+
+    @Test func holdToTalkKeepsTailAudioAndAllowsAnotherPress() {
+        let session = ChromecastVoiceSession()
+        var writes: [Data] = []
+        var events: [String] = []
+        var sampleGenerations: [Int] = []
+        session.onWrite = { writes.append($0) }
+        session.onStart = { events.append("start") }
+        session.onSamples = { samples, generation in
+            events.append("audio:\(samples.count)")
+            sampleGenerations.append(generation)
+        }
+        session.onStop = { events.append($0.logToken) }
+
+        #expect(session.acceptCapabilities(Data([0x0B, 1, 0, 2, 3, 0, 4])))
+        session.control(Data([0x08]), now: 0)
+        session.control(Data([0x04, 0x03, 0x02, 0x10]), now: 0.01)
+        session.audio(Data([1, 2, 3, 4]), now: 0.02)
+        session.control(Data([0x00, 0x02]), now: 2)
+        session.audio(Data([5, 6]), now: 2.02)
+        session.drain(now: 2.2)
+        session.audio(Data([7, 8]), now: 2.3)
+        session.control(Data([0x04, 0x03, 0x02, 0x11]), now: 3)
+        session.audio(Data([1, 2, 3, 4]), now: 3.02)
+        session.cancel(reason: "disconnect", now: 3.05)
+
+        #expect(writes.isEmpty)
+        #expect(sampleGenerations == [1, 1, 2])
+        #expect(events == [
+            "start", "audio:8", "audio:4", "hold_release",
+            "start", "audio:8", "cancelled.disconnect",
+        ])
+    }
+
+    @Test func syncAndReleaseKeepRemaindersAfterAFullHardwareFrame() {
+        let session = ChromecastVoiceSession()
+        var batches: [[Int16]] = []
+        var reasons: [ChromecastVoiceEndReason] = []
+        session.onSamples = { samples, _ in batches.append(samples) }
+        session.onStop = { reasons.append($0) }
+
+        #expect(session.acceptCapabilities(Data([0x0B, 1, 0, 2, 3, 0, 160])))
+        session.control(Data([0x04, 3, 2, 0x10]), now: 0)
+        session.audio(Data(repeating: 0, count: 173), now: 0.02)
+        session.control(Data([0x0A, 0, 0, 0, 0, 9, 0]), now: 0.03)
+        session.audio(Data(repeating: 0, count: 165), now: 0.04)
+        session.control(Data([0, 2]), now: 0.05)
+        session.drain(now: 0.18)
+
+        #expect(batches.map(\.count) == [320, 26, 320, 10])
+        #expect(batches[2].first == 9)
+        #expect(reasons == [.holdRelease])
+    }
+
+    @Test func dailyUseFollowsTheSelectedChineseInputMethod() {
+        #expect(OnboardingVoiceTool.chromecastTypingTool(
