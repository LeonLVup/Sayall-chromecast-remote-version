+    static let usagePage: UInt32 = 0x0c
+    static let controls: [UInt32: ChromecastRemoteControl] = [
+        0x041: .select, 0x042: .up, 0x043: .down,
+        0x044: .left, 0x045: .right, 0x223: .home, 0x224: .back,
+        0x077: .youtube, 0x078: .netflix, 0x0e2: .mute,
+        0x0e9: .volumeUp, 0x0ea: .volumeDown,
+    ]
+
+    static let nativeSources = controls.keys.sorted().map { UInt64(usagePage) << 32 | UInt64($0) }
+    static let displayOrder: [RemoteButton] = [
+        .up, .down, .left, .right, .ok, .back,
+        .home, .mute, .youtube, .netflix, .volumeUp, .volumeDown,
+    ]
+}
+
+/// Observes just the G9N9N Consumer Control interface. The host suppresses only
+/// the supported native usages before accepting user-configured actions.
+final class ChromecastHIDControls {
+    var prepareNativeInput: (([UInt64]) -> Bool)?
+    var restoreNativeInput: (() -> Void)?
+    var onControl: ((ChromecastRemoteControlEvent) -> Void)?
+    var onReadinessChange: (() -> Void)?
+    var onLog: ((String) -> Void)?
+
+    private(set) var readiness: RemoteFunctionReadiness = .unknown {
+        didSet {
+            if readiness != oldValue { onReadinessChange?() }
+        }
+    }
+    private var manager: IOHIDManager?
+    private var devices: Set<IOHIDDevice> = []
+    private var pressed: Set<ChromecastRemoteControl> = []
+    private var retry: DispatchWorkItem?
+    private var sequence = 0
+
+    func start() {
+        guard manager == nil else { return }
+        let manager = IOHIDManagerCreate(kCFAllocatorDefault, 0)
+        let context = Unmanaged.passUnretained(self).toOpaque()
+        IOHIDManagerSetDeviceMatching(manager, [
+            kIOHIDVendorIDKey: 0x18d1,
+            kIOHIDProductIDKey: 0x9450,
+            kIOHIDPrimaryUsagePageKey: ChromecastHIDControlMap.usagePage,
+            kIOHIDPrimaryUsageKey: 1,
+            kIOHIDTransportKey: "Bluetooth Low Energy"
+        ] as CFDictionary)
+        IOHIDManagerRegisterDeviceMatchingCallback(manager, { context, result, _, device in
+            guard let context, result == kIOReturnSuccess else { return }
+            Unmanaged<ChromecastHIDControls>.fromOpaque(context).takeUnretainedValue()
+                .deviceChanged(device, connected: true)
+        }, context)
+        IOHIDManagerRegisterDeviceRemovalCallback(manager, { context, _, _, device in
+            guard let context else { return }
+            Unmanaged<ChromecastHIDControls>.fromOpaque(context).takeUnretainedValue()
+                .deviceChanged(device, connected: false)
+        }, context)
+        IOHIDManagerRegisterInputValueCallback(manager, { context, result, _, value in
+            guard let context, result == kIOReturnSuccess else { return }
+            Unmanaged<ChromecastHIDControls>.fromOpaque(context).takeUnretainedValue()
+                .handle(value)
+        }, context)
+        let result = IOHIDManagerOpen(manager, 0)
+        guard result == kIOReturnSuccess else {
+            readiness = .failed
+            onLog?("CHROMECAST HID phase=open result=failed io_return=\(result)")
+            return
+        }
+        self.manager = manager
+        readiness = .checking
+        IOHIDManagerScheduleWithRunLoop(manager, CFRunLoopGetMain(), CFRunLoopMode.commonModes.rawValue)
+    }
+
+    func stop() {
+        if let manager {
+            self.manager = nil
+            IOHIDManagerUnscheduleFromRunLoop(manager, CFRunLoopGetMain(), CFRunLoopMode.commonModes.rawValue)
+            IOHIDManagerClose(manager, 0)
+        }
+        devices.removeAll()
+        reset(reason: "hid_stopped")
+        readiness = .unknown
+    }
+
+    private func deviceChanged(_ device: IOHIDDevice, connected: Bool) {
+        guard manager != nil else { return }
+        if connected {
+            guard devices.insert(device).inserted else { return }
+        } else {
+            guard devices.remove(device) != nil else { return }
+        }
+        reset(reason: connected ? "hid_devices_changed" : "hid_disconnected")
+        guard devices.count == 1 else {
+            readiness = devices.isEmpty ? .unknown : .failed
+            onLog?("CHROMECAST HID phase=match result=unavailable matched_interfaces=\(devices.count)")
+            return
+        }
+        readiness = .checking
+        prepare(attempt: 1)
+    }
+
+    private func prepare(attempt: Int) {
+        retry = nil
+        guard manager != nil, devices.count == 1 else { return }
+        if prepareNativeInput?(ChromecastHIDControlMap.nativeSources) == true {
+            readiness = .ready
+            onLog?("CHROMECAST HID phase=prepare result=ready attempt=\(attempt)")
+        } else if attempt < 5 {
+            let work = DispatchWorkItem { [weak self] in self?.prepare(attempt: attempt + 1) }
+            retry = work
+            DispatchQueue.main.asyncAfter(deadline: .now() + .milliseconds(250), execute: work)
+        } else {
+            readiness = .failed
+            onLog?("CHROMECAST HID phase=prepare result=failed reason=native_mapping_unavailable")
+        }
+    }
+
+    private func handle(_ value: IOHIDValue) {
+        let element = IOHIDValueGetElement(value)
+        guard devices.contains(IOHIDElementGetDevice(element)),
+              IOHIDElementGetUsagePage(element) == ChromecastHIDControlMap.usagePage,
+              let control = ChromecastHIDControlMap.controls[IOHIDElementGetUsage(element)],
+              readiness == .ready else { return }
+        let state = IOHIDValueGetIntegerValue(value)
+        switch state {
+        case 1 where pressed.insert(control).inserted:
+            emit(control, .began)
+        case 0 where pressed.remove(control) != nil:
+            emit(control, .ended)
+        default:
+            break
+        }
+    }
+
+    private func reset(reason: String) {
+        retry?.cancel()
+        retry = nil
+        let cancelled = pressed
+        pressed.removeAll()
+        for control in cancelled { emit(control, .cancelled, reason: reason) }
+        restoreNativeInput?()
+    }
+
+    private func emit(_ control: ChromecastRemoteControl, _ phase: ChromecastRemoteControlPhase, reason: String? = nil) {
+        sequence += 1
+        onLog?("CHROMECAST CONTROL phase=\(phase.rawValue) control=\(control.rawValue) sequence=\(sequence)")
+        onControl?(ChromecastRemoteControlEvent(
+            control: control, phase: phase, sequence: sequence, cancellationReason: reason
+        ))
+    }
+}
+#endif
